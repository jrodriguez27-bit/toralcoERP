generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum Role {
  ADMIN
  GERENTE
  CONTADOR
  COMPRAS
  ALMACEN
  RRHH
  VENTAS
  PROYECTOS
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(VIEWER)
  isActive      Boolean   @default(true)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE, UPDATE, DELETE, APPROVE, REJECT, POST, etc.
  entity     String   // Model name
  entityId   String
  changes    Json?    // { field: { old, new } }
  metadata   Json?    // Extra context
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// COMPANY CONFIGURATION
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  rnc       String   // RNC Dominicano
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?  // URL or base64
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model FiscalConfig {
  id          String   @id @default(cuid())
  key         String   @unique  // ITBIS_RATE, ISR_RETENTION_RATE, etc.
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fiscal_configs")
}

// ============================================================
// CATALOGOS MAESTROS
// ============================================================

// -- Plan de Cuentas (Chart of Accounts) --
model AccountCatalog {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g., "1.1.01.001"
  name        String
  type        AccountType
  nature      AccountNature  // DEBIT or CREDIT
  parentId    String?
  level       Int      @default(1)
  isActive    Boolean  @default(true)
  acceptsEntries Boolean @default(true) // Only leaf accounts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  parent      AccountCatalog?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    AccountCatalog[] @relation("AccountHierarchy")

  journalLines    JournalEntryLine[]
  costCodes       CostCode[]
  budgetLines     BudgetLine[]
  fixedAssets      FixedAsset[]

  @@index([parentId])
  @@map("account_catalog")
}

enum AccountType {
  ASSET        // Activo
  LIABILITY    // Pasivo
  EQUITY       // Patrimonio
  INCOME       // Ingreso
  EXPENSE      // Gasto
  COST         // Costo
}

enum AccountNature {
  DEBIT
  CREDIT
}

// -- Codigos de Costo ACT --
model CostCode {
  id          String   @id @default(cuid())
  code        String   @unique  // e.g., "01.01"
  name        String
  description String?
  accountId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  account     AccountCatalog? @relation(fields: [accountId], references: [id])

  budgetLines     BudgetLine[]
  requisitionLines RequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  stockMovements  StockMovement[]

  @@map("cost_codes")
}

// -- Clientes --
model Client {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  rnc         String?
  contactName String?
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal? @db.Decimal(18, 2)
  creditDays  Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  invoices    ClientInvoice[]
  projects    Project[]
  leads       Lead[]

  @@map("clients")
}

// -- Proveedores --
model Supplier {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  rnc             String?
  contactName     String?
  phone           String?
  email           String?
  address         String?
  paymentTermDays Int      @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  purchaseOrders  PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

// -- Almacenes --
model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  stocks          Stock[]
  stockMovements  StockMovement[]
  transfersFrom   Transfer[]    @relation("TransferFrom")
  transfersTo     Transfer[]    @relation("TransferTo")

  @@map("warehouses")
}

// -- Productos / Materiales --
model Product {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  unit          String   @default("UND") // UND, M2, M3, KG, GL, etc.
  category      String?
  minStock      Decimal  @default(0) @db.Decimal(18, 2)
  maxStock      Decimal? @db.Decimal(18, 2)
  lastCost      Decimal  @default(0) @db.Decimal(18, 2)
  averageCost   Decimal  @default(0) @db.Decimal(18, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  stocks             Stock[]
  stockMovements     StockMovement[]
  kardexEntries      KardexEntry[]
  requisitionLines   RequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  supplierInvoiceLines SupplierInvoiceLine[]
  clientInvoiceLines ClientInvoiceLine[]

  @@map("products")
}

// -- Proyectos / Centros de Costo --
model Project {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  clientId    String?
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  client      Client?  @relation(fields: [clientId], references: [id])

  budgets     Budget[]
  requisitions Requisition[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  employees   Employee[]
  fixedAssets  FixedAsset[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// ============================================================
// PRESUPUESTOS (BUDGETS)
// ============================================================

model Budget {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  projectId   String
  version     Int      @default(1)
  status      BudgetStatus @default(DRAFT)
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  notes       String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
  lines       BudgetLine[]

  @@map("budgets")
}

enum BudgetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CLOSED
}

model BudgetLine {
  id              String   @id @default(cuid())
  budgetId        String
  costCodeId      String
  accountId       String?
  description     String?
  quantity        Decimal  @default(1) @db.Decimal(18, 2)
  unitCost        Decimal  @default(0) @db.Decimal(18, 2)
  budgetedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  committedAmount Decimal  @default(0) @db.Decimal(18, 2) // Reserved by approved OCs
  executedAmount  Decimal  @default(0) @db.Decimal(18, 2) // Actually invoiced/spent
  availableAmount Decimal  @default(0) @db.Decimal(18, 2) // budgeted - committed - executed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budget    Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCode  CostCode       @relation(fields: [costCodeId], references: [id])
  account   AccountCatalog? @relation(fields: [accountId], references: [id])

  @@unique([budgetId, costCodeId])
  @@map("budget_lines")
}

// ============================================================
// ABASTECIMIENTO — REQUISICIONES
// ============================================================

model Requisition {
  id          String   @id @default(cuid())
  number      String   @unique  // REQ-2024-0001
  projectId   String
  description String?
  status      RequisitionStatus @default(DRAFT)
  requestedBy String
  approvedBy  String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
  lines       RequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@map("requisitions")
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_CONVERTED
  CONVERTED
  REJECTED
}

model RequisitionLine {
  id            String   @id @default(cuid())
  requisitionId String
  productId     String
  costCodeId    String?
  description   String?
  quantity      Decimal  @db.Decimal(18, 2)
  estimatedCost Decimal  @default(0) @db.Decimal(18, 2)
  convertedQty  Decimal  @default(0) @db.Decimal(18, 2) // Qty already sent to OC
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])
  costCode      CostCode?   @relation(fields: [costCodeId], references: [id])

  @@map("requisition_lines")
}

// ============================================================
// ORDENES DE COMPRA
// ============================================================

model PurchaseOrder {
  id              String   @id @default(cuid())
  number          String   @unique  // OC-2024-0001
  requisitionId   String?
  supplierId      String
  projectId       String
  status          PurchaseOrderStatus @default(DRAFT)
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  deliveryDate    DateTime?
  paymentTermDays Int      @default(30)
  notes           String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requisition     Requisition?  @relation(fields: [requisitionId], references: [id])
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id])
  lines           PurchaseOrderLine[]
  supplierInvoices SupplierInvoice[]

  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  costCodeId      String?
  description     String?
  quantity        Decimal  @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @default(0.18) @db.Decimal(5, 4) // ITBIS 18%
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  quantityReceived Decimal @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  costCode        CostCode?     @relation(fields: [costCodeId], references: [id])

  @@map("purchase_order_lines")
}

// ============================================================
// FACTURAS PROVEEDOR (ACCOUNTS PAYABLE)
// ============================================================

model SupplierInvoice {
  id              String   @id @default(cuid())
  number          String   @unique  // Internal sequential
  supplierInvNumber String?          // Supplier's own invoice number
  ncf             String?  @unique  // NCF del proveedor
  purchaseOrderId String?
  supplierId      String
  invoiceDate     DateTime
  dueDate         DateTime
  status          SupplierInvoiceStatus @default(PENDING)
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2) // ITBIS
  isrRetention    Decimal  @default(0) @db.Decimal(18, 2) // Retencion ISR
  itbisRetention  Decimal  @default(0) @db.Decimal(18, 2) // Retencion ITBIS
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(18, 2)
  notes           String?
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  lines           SupplierInvoiceLine[]
  payments        PaymentApplication[]

  @@map("supplier_invoices")
}

enum SupplierInvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model SupplierInvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  productId       String?
  description     String
  quantity        Decimal  @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)
  taxRate         Decimal  @default(0.18) @db.Decimal(5, 4)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice         SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id])

  @@map("supplier_invoice_lines")
}

// ============================================================
// PAGOS A PROVEEDORES
// ============================================================

model Payment {
  id              String   @id @default(cuid())
  number          String   @unique  // PAG-2024-0001
  paymentDate     DateTime
  paymentMethod   PaymentMethod
  bankAccount     String?
  reference       String?  // Check number, transfer ref
  totalAmount     Decimal  @db.Decimal(18, 2)
  notes           String?
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalEntry    JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  applications    PaymentApplication[]

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CREDIT_CARD
}

model PaymentApplication {
  id              String   @id @default(cuid())
  paymentId       String
  invoiceId       String
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  payment         Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice         SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("payment_applications")
}

// ============================================================
// CONCILIACION BANCARIA
// ============================================================

model BankTransaction {
  id              String   @id @default(cuid())
  bankAccount     String
  transactionDate DateTime
  description     String
  reference       String?
  amount          Decimal  @db.Decimal(18, 2)
  type            BankTransactionType
  isReconciled    Boolean  @default(false)
  matchedEntryId  String?  // Matched JournalEntry
  importBatch     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bank_transactions")
}

enum BankTransactionType {
  DEBIT
  CREDIT
}

// ============================================================
// INVENTARIO
// ============================================================

model Stock {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(18, 2)
  reservedQty Decimal  @default(0) @db.Decimal(18, 2) // Reserved for transfers
  availableQty Decimal @default(0) @db.Decimal(18, 2) // quantity - reservedQty
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("stocks")
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  warehouseId   String
  type          MovementType
  quantity      Decimal  @db.Decimal(18, 2) // Always positive
  unitCost      Decimal  @default(0) @db.Decimal(18, 2)
  totalCost     Decimal  @default(0) @db.Decimal(18, 2)
  reference     String?  // OC number, transfer number, etc.
  referenceType String?  // PURCHASE_ORDER, TRANSFER, ADJUSTMENT, CONSUMPTION
  referenceId   String?
  projectId     String?
  costCodeId    String?
  notes         String?
  createdAt     DateTime @default(now())

  product       Product   @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  project       Project?  @relation(fields: [projectId], references: [id])
  costCode      CostCode? @relation(fields: [costCodeId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum MovementType {
  ENTRY        // Entrada
  EXIT         // Salida
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

model KardexEntry {
  id            String   @id @default(cuid())
  productId     String
  date          DateTime
  type          String   // COMPRA, CONSUMO, AJUSTE, TRANSFERENCIA
  reference     String?
  entryQty      Decimal  @default(0) @db.Decimal(18, 2)
  entryUnitCost Decimal  @default(0) @db.Decimal(18, 2)
  entryTotal    Decimal  @default(0) @db.Decimal(18, 2)
  exitQty       Decimal  @default(0) @db.Decimal(18, 2)
  exitUnitCost  Decimal  @default(0) @db.Decimal(18, 2)
  exitTotal     Decimal  @default(0) @db.Decimal(18, 2)
  balanceQty    Decimal  @default(0) @db.Decimal(18, 2)
  balanceUnitCost Decimal @default(0) @db.Decimal(18, 2)
  balanceTotal  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId, date])
  @@map("kardex_entries")
}

model Transfer {
  id              String   @id @default(cuid())
  number          String   @unique  // TRF-2024-0001
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(REQUESTED)
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines           TransferLine[]

  @@map("transfers")
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model TransferLine {
  id          String   @id @default(cuid())
  transferId  String
  productId   String
  quantity    Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("transfer_lines")
}

// ============================================================
// FACTURACION CLIENTE (ACCOUNTS RECEIVABLE)
// ============================================================

model NcfSequence {
  id          String   @id @default(cuid())
  type        String   // B01, B02, B14, B15
  prefix      String
  currentNumber Int    @default(0)
  rangeFrom   Int
  rangeTo     Int
  expirationDate DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, prefix])
  @@map("ncf_sequences")
}

model ClientInvoice {
  id              String   @id @default(cuid())
  number          String   @unique  // FAC-2024-0001
  ncf             String?  @unique
  ncfType         String?  // B01, B02, etc.
  clientId        String
  invoiceDate     DateTime
  dueDate         DateTime
  status          ClientInvoiceStatus @default(DRAFT)
  subtotal        Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2) // ITBIS
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(18, 2)
  notes           String?
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client         @relation(fields: [clientId], references: [id])
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  lines           ClientInvoiceLine[]
  creditNotes     CreditNote[]
  collections     CollectionApplication[]

  @@map("client_invoices")
}

enum ClientInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model ClientInvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(18, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  taxRate     Decimal  @default(0.18) @db.Decimal(5, 4)
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice     ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id])

  @@map("client_invoice_lines")
}

model CreditNote {
  id              String   @id @default(cuid())
  number          String   @unique
  ncf             String?  @unique
  invoiceId       String
  amount          Decimal  @db.Decimal(18, 2)
  reason          String
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice         ClientInvoice  @relation(fields: [invoiceId], references: [id])
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id])

  @@map("credit_notes")
}

model Collection {
  id              String   @id @default(cuid())
  number          String   @unique  // COB-2024-0001
  collectionDate  DateTime
  paymentMethod   PaymentMethod
  bankAccount     String?
  reference       String?
  totalAmount     Decimal  @db.Decimal(18, 2)
  notes           String?
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalEntry    JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  applications    CollectionApplication[]

  @@map("collections")
}

model CollectionApplication {
  id            String   @id @default(cuid())
  collectionId  String
  invoiceId     String
  amount        Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  invoice       ClientInvoice @relation(fields: [invoiceId], references: [id])

  @@map("collection_applications")
}

// ============================================================
// CONTABILIDAD
// ============================================================

model AccountingPeriod {
  id          String   @id @default(cuid())
  name        String   // "Enero 2024", "Febrero 2024"
  startDate   DateTime
  endDate     DateTime
  year        Int
  month       Int
  isClosed    Boolean  @default(false)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journalEntries JournalEntry[]

  @@unique([year, month])
  @@map("accounting_periods")
}

model JournalEntry {
  id          String   @id @default(cuid())
  number      String   @unique  // AST-2024-0001
  periodId    String
  date        DateTime
  description String
  type        JournalEntryType @default(MANUAL)
  reference   String?  // Source document
  referenceType String? // SUPPLIER_INVOICE, CLIENT_INVOICE, PAYMENT, etc.
  referenceId String?
  status      JournalEntryStatus @default(DRAFT)
  totalDebit  Decimal  @default(0) @db.Decimal(18, 2)
  totalCredit Decimal  @default(0) @db.Decimal(18, 2)
  postedBy    String?
  postedAt    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period      AccountingPeriod @relation(fields: [periodId], references: [id])
  lines       JournalEntryLine[]

  supplierInvoices SupplierInvoice[]
  clientInvoices   ClientInvoice[]
  creditNotes      CreditNote[]
  payments         Payment[]
  collections      Collection[]
  payrollRuns      PayrollRun[]
  depreciationRuns DepreciationRun[]

  @@index([date])
  @@index([periodId])
  @@map("journal_entries")
}

enum JournalEntryType {
  MANUAL
  AUTOMATIC
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntryLine {
  id          String   @id @default(cuid())
  entryId     String
  accountId   String
  description String?
  debit       Decimal  @default(0) @db.Decimal(18, 2)
  credit      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  entry       JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     AccountCatalog @relation(fields: [accountId], references: [id])

  @@map("journal_entry_lines")
}

// ============================================================
// NOMINA (PAYROLL)
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  code            String   @unique
  firstName       String
  lastName        String
  cedula          String   @unique
  birthDate       DateTime?
  hireDate        DateTime
  terminationDate DateTime?
  department      String?
  position        String
  projectId       String?  // Project assignment for obreros
  employeeType    EmployeeType @default(ADMINISTRATIVE)
  baseSalary      Decimal  @db.Decimal(18, 2)
  bankAccount     String?
  bankName        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  project         Project?  @relation(fields: [projectId], references: [id])
  payrollDetails  PayrollDetail[]

  @@map("employees")
}

enum EmployeeType {
  ADMINISTRATIVE
  FIELD_WORKER  // Obrero
  TECHNICIAN
  MANAGER
}

model PayrollRun {
  id              String   @id @default(cuid())
  number          String   @unique  // NOM-2024-01
  periodStart     DateTime
  periodEnd       DateTime
  type            PayrollType @default(MONTHLY)
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2)
  totalNet        Decimal  @default(0) @db.Decimal(18, 2)
  totalEmployerCost Decimal @default(0) @db.Decimal(18, 2)
  approvedBy      String?
  approvedAt      DateTime?
  journalEntryId  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  details         PayrollDetail[]

  @@map("payroll_runs")
}

enum PayrollType {
  MONTHLY
  BIWEEKLY
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  POSTED
}

model PayrollDetail {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  baseSalary      Decimal  @db.Decimal(18, 2)
  overtimeHours   Decimal  @default(0) @db.Decimal(18, 2)
  overtimeAmount  Decimal  @default(0) @db.Decimal(18, 2)
  bonuses         Decimal  @default(0) @db.Decimal(18, 2)
  grossPay        Decimal  @default(0) @db.Decimal(18, 2)
  // Employee deductions
  afpEmployee     Decimal  @default(0) @db.Decimal(18, 2) // 2.87%
  sfsEmployee     Decimal  @default(0) @db.Decimal(18, 2) // 3.04%
  isrAmount       Decimal  @default(0) @db.Decimal(18, 2) // ISR tabla progresiva
  otherDeductions Decimal  @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(18, 2)
  netPay          Decimal  @default(0) @db.Decimal(18, 2)
  // Employer contributions
  afpEmployer     Decimal  @default(0) @db.Decimal(18, 2) // 7.10%
  sfsEmployer     Decimal  @default(0) @db.Decimal(18, 2) // 7.09%
  srlEmployer     Decimal  @default(0) @db.Decimal(18, 2) // 1.0-1.6%
  infotepEmployer Decimal  @default(0) @db.Decimal(18, 2) // 1.0%
  totalEmployerCost Decimal @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_details")
}

// ============================================================
// ACTIVOS FIJOS (FIXED ASSETS)
// ============================================================

model FixedAssetCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  usefulLifeMonths Int
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  depreciationAccountId String?
  expenseAccountId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets        FixedAsset[]

  @@map("fixed_asset_categories")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model FixedAsset {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  categoryId      String
  projectId       String?
  accountId       String?  // Asset account
  acquisitionDate DateTime
  acquisitionCost Decimal  @db.Decimal(18, 2)
  residualValue   Decimal  @default(0) @db.Decimal(18, 2)
  usefulLifeMonths Int
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2)
  bookValue       Decimal  @default(0) @db.Decimal(18, 2)
  status          AssetStatus @default(ACTIVE)
  location        String?
  serialNumber    String?
  disposalDate    DateTime?
  disposalAmount  Decimal? @db.Decimal(18, 2)
  disposalGainLoss Decimal? @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        FixedAssetCategory @relation(fields: [categoryId], references: [id])
  project         Project?           @relation(fields: [projectId], references: [id])
  account         AccountCatalog?    @relation(fields: [accountId], references: [id])
  maintenances    AssetMaintenance[]
  depreciationEntries DepreciationEntry[]

  @@map("fixed_assets")
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  TRANSFERRED
  MAINTENANCE
}

model DepreciationRun {
  id              String   @id @default(cuid())
  period          String   // "2024-01"
  runDate         DateTime
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  journalEntryId  String?
  createdAt       DateTime @default(now())

  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  entries         DepreciationEntry[]

  @@map("depreciation_runs")
}

model DepreciationEntry {
  id              String   @id @default(cuid())
  runId           String
  assetId         String
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  run             DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset           FixedAsset      @relation(fields: [assetId], references: [id])

  @@map("depreciation_entries")
}

model AssetMaintenance {
  id              String   @id @default(cuid())
  assetId         String
  type            MaintenanceType
  description     String
  scheduledDate   DateTime?
  completedDate   DateTime?
  cost            Decimal  @default(0) @db.Decimal(18, 2)
  vendor          String?
  status          MaintenanceStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset           FixedAsset @relation(fields: [assetId], references: [id])

  @@map("asset_maintenances")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================
// CRM
// ============================================================

model Lead {
  id            String   @id @default(cuid())
  name          String
  company       String?
  contactName   String?
  email         String?
  phone         String?
  source        String?  // Referido, Web, Llamada, etc.
  stage         LeadStage @default(NEW)
  estimatedValue Decimal? @db.Decimal(18, 2)
  probability   Int?     // 0-100
  clientId      String?  // If converted
  notes         String?
  assignedTo    String?
  nextFollowUp  DateTime?
  wonDate       DateTime?
  lostDate      DateTime?
  lostReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        Client?  @relation(fields: [clientId], references: [id])
  activities    LeadActivity[]
  proposals     Proposal[]

  @@map("leads")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  type        String   // CALL, EMAIL, MEETING, NOTE
  description String
  date        DateTime
  createdBy   String?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

model Proposal {
  id            String   @id @default(cuid())
  number        String   @unique  // PROP-2024-0001
  leadId        String
  title         String
  status        ProposalStatus @default(DRAFT)
  validUntil    DateTime?
  subtotal      Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lead          Lead     @relation(fields: [leadId], references: [id])
  lines         ProposalLine[]

  @@map("proposals")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model ProposalLine {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  quantity    Decimal  @db.Decimal(18, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("proposal_lines")
}

// ============================================================
// DOCUMENT SEQUENCES
// ============================================================

model DocumentSequence {
  id          String   @id @default(cuid())
  type        String   @unique  // REQUISITION, PURCHASE_ORDER, SUPPLIER_INVOICE, etc.
  prefix      String
  currentNumber Int    @default(0)
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("document_sequences")
}
